# TechnoBot backend environment configuration
# Copy this file to .env and fill in any values you need.
# Most settings have sensible defaults — only override what you need.
#
# Usage:
#   cp .env.example .env
#   # edit .env as needed
#   uvicorn api_server:app --reload --port 8000

# ── Encoding (required on Windows with emoji in folder path) ──────────────────
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# ── Server ────────────────────────────────────────────────────────────────────
# Host and port are set via the uvicorn CLI, not env vars.
# Example: uvicorn api_server:app --host 0.0.0.0 --port 8000 --reload

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# Default is localhost:11434 — change if Ollama runs on a different host.
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=llama3.1
# OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# ── Yahoo Finance / rate limiting ─────────────────────────────────────────────
# No API key required — yfinance uses unauthenticated public endpoints.
# Rate limiting is handled automatically via the 5-minute 429 cooldown.

# ── Alpha Vantage secondary fallback (priority 2 of 3) ───────────────────────
# Free tier: 25 requests/day, 5 requests/minute.
# A bundled default key is included — set your own for higher reliability.
# Sign up at: https://www.alphavantage.co/support/#api-key
#
# ALPHAVANTAGE_API_KEY=N5EM5IA0L4UA7A8W   ← bundled default (override if needed)
#
# Optional tuning (defaults shown):
# AV_TIMEOUT_SEC=2       # per-request timeout in seconds (hard cap — 2s max)
# AV_MAX_RETRIES=1       # 1 = single attempt, no retry

# ── Twelve Data tertiary fallback (priority 3 of 3) ───────────────────────────
# Optional but strongly recommended.  When Yahoo Finance fails or rate-limits,
# TechnoBot automatically falls back to Twelve Data invisibly.
#
# Free tier: 800 API credits/day, 8 requests/minute.
# Sign up at: https://twelvedata.com/  (free, no credit card required)
#
# Without this key: Yahoo failures result in "data unavailable" messages.
# With this key:    Yahoo failures are silently recovered — users see no disruption.
#
# TWELVEDATA_API_KEY=your_api_key_here
#
# Optional tuning (defaults shown):
# TD_TIMEOUT_SEC=2        # per-request timeout in seconds (hard cap — 2s max)
# TD_MAX_RETRIES=1        # 1 = single attempt, no retry

# ── Logging ───────────────────────────────────────────────────────────────────
# All TechnoBot log lines are prefixed with [TechnoBot/...] for easy filtering.
# No separate log file — output goes to the uvicorn console.
