import ChatMessage from "./chat-message";

type Message = {
  id: string;
  role: "user" | "assistant";
  content: string;
};

type Props = {
  messages: Message[];
  isAnalysing: boolean;
  onSend: (text: string) => void;
};

export default function ChatWindow({ messages, isAnalysing, onSend }: Props) {
  return (
    <div className="flex flex-col h-full">
      <div className="flex-1 overflow-y-auto space-y-4 p-4 pb-40">
        {messages.map((msg) => (
          <ChatMessage key={msg.id} message={msg} />
        ))}

        {isAnalysing && (
          <div className="text-sm text-muted-foreground italic">
            🤖 TechnoBot is analysing…
          </div>
        )}
      </div>

      {/* your existing input box goes here */}
      {/* on submit → onSend(text) */}
    </div>
  );
}
